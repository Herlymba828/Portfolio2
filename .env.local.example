# Variables d'environnement pour le portfolio
# Copiez ce fichier vers .env.local et remplissez les valeurs
# Toutes les variables ci-dessous sont optionnelles : sans elles, le site
# fonctionne normalement en local (le formulaire de contact log les messages
# en console au lieu de les envoyer par email, et le tracking est désactivé).

# API Resend pour l'envoi d'emails (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Code de vérification Google Search Console
GOOGLE_VERIFICATION_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics Tracking ID (format G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX