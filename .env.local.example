# Variables d'environnement pour le portfolio
# Copiez ce fichier vers .env.local et remplissez les valeurs

# API Resend pour l'envoi d'emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Token GitHub pour éviter les limites de rate limiting (optionnel)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Code de vérification Google Search Console (optionnel)
GOOGLE_VERIFICATION_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics Tracking ID (optionnel)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Environment
NODE_ENV=development

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000